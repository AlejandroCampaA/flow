{
  "name": "flujo",
  "version": "1.1.0",
  "description": "Flujo: tu nómina, tus cuentas y a dónde se va tu dinero.",
  "main": "boot.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:parse": "tsx scripts/test-parse.mts",
    "sello": "node scripts/sello.mjs",
    "publicar": "electron-vite build && node scripts/sello.mjs && node scripts/publicar.mjs",
    "dist": "electron-vite build && node scripts/sello.mjs && electron-builder --win dir && node scripts/publicar.mjs --instalador",
    "paquete": "node scripts/paquete.mjs"
  },
  "author": "Flujo",
  "license": "UNLICENSED",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/sql.js": "^1.16.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "fast-xml-parser": "^4.5.7",
    "lucide-react": "^1.77.0",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@tesseract.js-data/spa": "^1.0.0",
    "sql.js": "^1.13.0",
    "tesseract.js": "^6.0.1"
  },
  "productName": "Flujo",
  "build": {
    "appId": "com.flujo.app",
    "productName": "Flujo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "boot.cjs",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "dir",
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Flujo-${version}-win.${ext}"
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "electronDist": "node_modules/electron/dist"
  }
}
